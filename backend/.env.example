APP_NAME=Revolution API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Supabase — the backend is the only writer. Use the SERVICE ROLE key, not the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Phone verification via WhatsApp (free, user-initiated) ------------------
# Your WhatsApp Cloud API number, E.164 WITHOUT the '+'. The user sends their
# code here. Leave blank while testing with OTP_DEBUG_RETURN_CODE=true.
WHATSAPP_BUSINESS_NUMBER=15551234567

# From Meta → WhatsApp → API Setup (only needed to auto-reply "Verified ✅").
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# You choose this string; enter the SAME value in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=revolution-verify

# OTP tuning.
OTP_LENGTH=4
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# DEV ONLY: return the code in the API response so you can test without WhatsApp.
# Set to false in production.
OTP_DEBUG_RETURN_CODE=true

# --- Groq (AI daily one-liners on Home) ------------------------------------
# One app-wide key from console.groq.com (starts "gsk_"). Unset → no AI lines,
# the app uses its built-in wording. Optionally override the model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant